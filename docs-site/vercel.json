{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vitepress",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": ".vitepress/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "if [ \"$VERCEL_ENV\" != \"production\" ]; then exit 0; elif [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ]; then git diff --quiet $VERCEL_GIT_PREVIOUS_SHA $VERCEL_GIT_COMMIT_SHA -- .; else exit 1; fi",
  "rewrites": [
    {
      "source": "/download",
      "destination": "/api/download"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
